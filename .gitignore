# Raw rosbags: too large for git; kept on disk only (irreplaceable evidence)
bags/

# Third-party pinned sources with their own git history.
# Local modifications are tracked as patch files under patches/.
ws_slam/
ws_base/
ws_livox/
vendor/

# Colcon/workspace build artifacts
build/
install/
log/

# Large raw evidence dumps (stage-2 CAN message streams, ~15 MB each)
docs/02_evidence/*/ros_messages.jsonl

# Upstream manuals (kept on disk, fetched artifacts)
*.pdf

# OS noise
.DDS/
*.swp
__pycache__/
*.pyc
*.xwd
MvSdkLog/
$(ALLUSERSPROFILE)/
ws_camera/*
!ws_camera/src/
ws_camera/src/*
!ws_camera/src/hik_camera_trigger_driver/
!ws_camera/src/timeshare_writer/
ws_camera/src/hik_camera_trigger_driver/hikSDK
ws_fast_livo/
!ws_fast_livo/
ws_fast_livo/*
!ws_fast_livo/src/
docs/fast_livo2_evidence/**/*.xwd
mvs/

# Local managed-session state and per-run logs
.runtime/

# Integrated calibration: retain procedures/configuration; raw captures/results
# stay on disk and in the migration manifest, as with bags/ and local workspaces.
calibration/ws_calib/
calibration/bags/
calibration/logs/
calibration/MvSdkLog/
calibration/$(ALLUSERSPROFILE)/
calibration/**/datasets/
calibration/**/logs/
calibration/**/results_archive/
calibration/**/session_*/
calibration/**/combined_*/
calibration/**/build_manual/
calibration/**/build_integrated/
calibration/**/install_integrated/
