+  // Archived calibration has six decimal places. Reject invalid rotations;
+  // project only tiny rounding error to SO(3), preserving the source artifact.
+  if ((Rcl.transpose()*Rcl-M3D::Identity()).norm() > 1e-5 || Rcl.determinant() < 0.99)
