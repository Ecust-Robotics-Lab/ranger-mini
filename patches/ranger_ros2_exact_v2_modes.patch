+// V2 body-twist / SDK packet conversion. No ROS, I/O or implicit mode changes.
+#ifndef RANGER_BASE_V2_COMMAND_HPP
+#define RANGER_BASE_V2_COMMAND_HPP
+#include <cmath>
+#include <algorithm>
+namespace westonrobot {
+struct V2Command { bool valid; double speed, steering, angular; };
+inline V2Command V2BodyCommand(double vx, double vy, double wz, unsigned mode,
+                              double max_speed=.30, double max_yaw=.50,
+                              double min_radius=.55, bool native_front_opposite=false) {
+  // User body +X points toward the camera-facing physical front. Some
+  // installations put that end opposite the chassis SDK longitudinal axis.
+  if (native_front_opposite) {vx=-vx;vy=-vy;}
+  if (!std::isfinite(vx) || !std::isfinite(vy) || !std::isfinite(wz) ||
+      std::hypot(vx,vy)>max_speed+1e-6 || std::abs(wz)>max_yaw+1e-6 || mode>2)
+    return {false,0,0,0};
+  if (std::abs(vx)+std::abs(vy)+std::abs(wz)<1e-9) return {true,0,0,0};
+  if (mode==0) {
+    if (std::abs(vy)>1e-6 || std::abs(wz)>std::abs(vx)/min_radius+1e-6 || std::abs(vx)<1e-9)
+      return {false,0,0,0};
+    // Dual Ackermann: body vx = wheel speed*cos(phi), wz=2*speed*sin(phi)/L.
+    const double L=.494, track=.364;
+    const double phi=std::atan(wz*L/(2*vx));
+    const double a=std::abs(phi);
+    const double inner=std::copysign(std::atan2(L*std::sin(a), L*std::cos(a)-track*std::sin(a)),phi);
+    if (std::abs(inner)>.6981+1e-6) return {false,0,0,0};
+    return {true,vx/std::cos(phi),inner,0};
+  }
+  if (mode==1) {
+    if (std::abs(wz)>1e-6) return {false,0,0,0};
+    if (std::abs(vx)<1e-9) return {true,vy,M_PI/2,0};
+    const double sign=vx<0?-1.:1.;
+    return {true,sign*std::hypot(vx,vy),std::atan2(sign*vy,sign*vx),0};
+  }
+  if (std::abs(vx)+std::abs(vy)>1e-6) return {false,0,0,0};
+  return {true,0,0,wz};
+}
+}  // namespace westonrobot
+#endif
