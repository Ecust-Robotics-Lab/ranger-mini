diff --git a/src/core/lio/extrinsic_cloud.h b/src/core/lio/extrinsic_cloud.h
new file mode 100644
--- /dev/null
+++ b/src/core/lio/extrinsic_cloud.h
@@ -0,0 +1,15 @@
+#pragma once
+#include "common/point_def.h"
+#include <pcl/common/transforms.h>
+namespace lightning {
+// Keyframe poses are T_WI; store points in I so loops and map export use T_WI*p_I.
+inline CloudPtr LidarCloudInImuFrame(const CloudPtr& input, const Eigen::Matrix3d& R_IL,
+                                    const Eigen::Vector3d& t_IL) {
+    Eigen::Matrix4f T = Eigen::Matrix4f::Identity();
+    T.block<3, 3>(0, 0) = R_IL.cast<float>();
+    T.block<3, 1>(0, 3) = t_IL.cast<float>();
+    CloudPtr output(new PointCloudType);
+    pcl::transformPointCloud(*input, *output, T);
+    return output;
+}
+}  // namespace lightning
