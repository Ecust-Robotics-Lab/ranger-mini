+void RangerROSMessenger::SubmitV2(double speed,double steering,double angular,const char* reason) {
+  // Records the SDK API submission, not a CAN acknowledgement or measured speed.
+  robot_->SetMotionCommand(speed,steering,angular);
+  submitted_speed_=speed;submitted_steering_=steering;submitted_angular_=angular;
+  last_submission_=SdkClock::now();execution_reason_=reason;
+}
+
+void RangerROSMessenger::PublishExecutionState() {
+  if (!execution_pub_ || robot_type_!=RangerSubType::kRangerMiniV2) return;
+  const auto now=SdkClock::now();
+  const auto age=[now](SdkTimePoint t){return t==SdkTimePoint{}?-1.:std::chrono::duration<double>(now-t).count();};
+  const auto feedback=robot_->GetRobotState();
+  std::ostringstream out;out<<std::setprecision(17);
+  const auto number=[&out](double v){if(std::isfinite(v))out<<v;else out<<"null";};
+  out<<"{\"schema_version\":1,\"host_stamp_ns\":"<<node_->get_clock()->now().nanoseconds()
+     <<",\"session\":\""<<execution_session_<<"\",\"receive_only\":"<<(receive_only_?"true":"false")
+     <<",\"feedback_ready\":"<<(V2FeedbackReady()?"true":"false")<<",\"mode\":"<<unsigned(motion_mode_)
+     <<",\"reason\":\""<<execution_reason_<<"\",\"requested_body\":[";
+  number(requested_vx_);out<<',';number(requested_vy_);out<<',';number(requested_wz_);
+  out<<"],\"submitted_sdk\":[";number(submitted_speed_);out<<',';number(submitted_steering_);out<<',';number(submitted_angular_);
+  out<<"],\"command_age_s\":"<<age(last_cmd_)<<",\"submission_age_s\":"<<age(last_submission_)
+     <<",\"feedback_age_s\":"<<age(feedback.motion_stamp)<<",\"mode_age_s\":"<<age(feedback.mode_stamp)
+     <<",\"system_age_s\":"<<age(feedback.system_stamp)<<",\"feedback_steering\":";number(v2_feedback_steering_sign_*feedback.motion_state.steering_angle);
+  out<<'}';std_msgs::msg::String message;message.data=out.str();execution_pub_->publish(message);
+}
+
+bool RangerROSMessenger::V2FeedbackReady() const {
+  const auto s=robot_->GetRobotState();
+  const auto now=SdkClock::now();
+  for (auto t : {s.system_stamp,s.motion_stamp,s.mode_stamp}) {
+    if (t==SdkTimePoint{} || now-t>std::chrono::milliseconds(250)) return false;
+  }
+  return s.system_state.control_mode==1 && s.system_state.vehicle_state==0 && s.system_state.error_code==0;
+}
+
+void RangerROSMessenger::ModeCmdCallback(std_msgs::msg::UInt8::SharedPtr msg) {
+  if (receive_only_ || robot_type_!=RangerSubType::kRangerMiniV2 || msg->data>2 || !V2FeedbackReady()) return;
+  const auto now=SdkClock::now();
+  if (msg->data==requested_mode_ && msg->data==motion_mode_) {
+    last_mode_request_=now;
+    return;
+  }
+  if (stopped_since_==SdkTimePoint{} || std::chrono::duration<double>(now-stopped_since_).count()<nav_stop_dwell_) return;
+  requested_mode_=msg->data;
+  last_mode_request_=now;
+  SubmitV2(0.,last_steering_,0.,"mode_switch");
+  if (motion_mode_!=requested_mode_) robot_->SetMotionMode(requested_mode_);
+  // motion_mode_ is assigned exclusively from actual feedback for V2.
+}
+
+void RangerROSMessenger::CommandWatchdog() {
+  if (receive_only_ || !robot_ || robot_type_!=RangerSubType::kRangerMiniV2) return;
+  const auto now=SdkClock::now();
+  if (last_cmd_==SdkTimePoint{} || now-last_cmd_>std::chrono::milliseconds(100) || !V2FeedbackReady())
+    SubmitV2(0.,last_steering_,0.,"command_watchdog");
+}
