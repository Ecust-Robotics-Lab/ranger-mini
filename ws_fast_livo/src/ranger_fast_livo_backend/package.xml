<?xml version="1.0"?>
<package format="3">
  <name>ranger_fast_livo_backend</name><version>0.1.0</version>
  <description>Independent FAST-LIVO2 keyframes, geometric loops and Pose3 graph. No TF broadcaster.</description>
  <maintainer email="dev@example.com">ranger_nav</maintainer><license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclcpp</depend><depend>std_msgs</depend><depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend><depend>nav_msgs</depend><depend>diagnostic_msgs</depend>
  <depend>pcl_conversions</depend><depend>eigen</depend>
  <depend>nlohmann_json</depend><depend>openssl</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
