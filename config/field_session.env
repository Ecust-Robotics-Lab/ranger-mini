# ranger_nav 现场会话参数（scripts/field_session.sh 读取）
# 改这里即可调参；所有变量也可用环境变量临时覆盖（文件用 ${VAR:-默认} 写法，
# 外部已设置的值不会被覆盖——2026-09-28 修复：此前 source 会覆盖外部覆盖值）。

# ---- 组件开关（0=该组件不启动）------------------------------
ENABLE_LIDAR="${ENABLE_LIDAR:-1}"     # 雷达驱动（Mid-360S）
ENABLE_BASE="${ENABLE_BASE:-1}"       # 底盘驱动（注意：启动即发 CAN 控制模式配置，遥控器在手）
ENABLE_LOC="${ENABLE_LOC:-1}"         # Lightning 在线定位
ENABLE_BRIDGE="${ENABLE_BRIDGE:-1}"   # ranger_localization_bridge（map->odom + navigation_ready）
ENABLE_AUX="${ENABLE_AUX:-1}"         # 辅助节点：派生点云 / 静态外参TF / foxglove_bridge
ENABLE_MAP_PUB="${ENABLE_MAP_PUB:-0}" # 导航会话保持 0：/map 由 map_server 提供，避免双 latched 发布

# ---- 雷达驱动 ------------------------------------------------
LIDAR_SECONDS=3600   # 自动正常退出时限（秒）；驱动脚本硬上限 3600，超时后重启会话或单独补起

# ---- 定位 ----------------------------------------------------
LOC_CONFIG=config/slam/ranger_mid360s_loc_v2.yaml   # 2026-09-28 重录地图（2lx5kkho）
TF_CHILD="${TF_CHILD:-imu_link}"
# 固定启动点初始位姿（默认单位阵=建图起点同朝向；车放别处时改这里）
INIT_X=-0.85
INIT_Y=-0.31
INIT_Z=0.0
INIT_QX="${INIT_QX:-0.0}"
INIT_QY="${INIT_QY:-0.0}"
INIT_QZ=-0.951
INIT_QW=0.309

# ---- 地图发布（Foxglove 二维图，非导航会话用）----------------
MAP_DIR="${MAP_DIR:-maps/lightning-offline-suej7qsz/data/new_map}"

# ---- 桥接参数 ------------------------------------------------
# base_link->imu_link 外参（当前为用户约值，精测后更新）
T_BASE_IMU_XYZ="${T_BASE_IMU_XYZ:-[0.0,0.0,0.556]}"
T_BASE_IMU_RPY="${T_BASE_IMU_RPY:-[0.0,0.0,0.0]}"
MIN_CONFIDENCE="${MIN_CONFIDENCE:-1.0}"
# 额外桥接 launch 参数原样透传，如 "innovation_yaw_th_deg:=30 tf_max_age_s:=0.8"
BRIDGE_EXTRA_ARGS="tf_max_age_s:=1.5"

# ---- Foxglove ------------------------------------------------
# foxglove_bridge WebSocket：Foxglove 里连接 ws://<本机IP>:8765
