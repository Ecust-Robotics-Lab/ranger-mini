<?xml version="1.0" encoding="UTF-8"?>
<!-- Low-bandwidth finalization RPC: loopback UDP, no SHM segment allocation. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>ranger_mapping_control_loopback</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="ranger_mapping_control" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>ranger_mapping_control_loopback</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
