+}
+// One full deskewed LIVO interval, in the IMU body at its end (the image update
+// time). Publish only AFTER visual correction; never feed the colored accumulated
+// world cloud to PGO. State is T_local_imu; extrinsics are T_imu_lidar.
+void LIVMapper::publishBackendFrame()
+{
+  if (p_imu->imu_need_init || backend_deskewed_lidar.empty() ||
+      std::abs(backend_deskew_time-LidarMeasures.last_lio_update_time)>1e-6) return;
+  if (!_state.rot_end.allFinite() || !_state.pos_end.allFinite())
+    throw std::runtime_error("Non-finite frontend state");
+  nav_msgs::msg::Odometry odom;
+  odom.header.frame_id = "fast_livo_local";
+  odom.child_frame_id = "fast_livo_imu";
+  odom.header.stamp = sec2Stamp(LidarMeasures.last_lio_update_time);
+  Eigen::Quaterniond q(_state.rot_end);
+  q.normalize();
+  odom.pose.pose.position.x = _state.pos_end.x();
+  odom.pose.pose.position.y = _state.pos_end.y();
+  odom.pose.pose.position.z = _state.pos_end.z();
+  odom.pose.pose.orientation.x = q.x(); odom.pose.pose.orientation.y = q.y();
+  odom.pose.pose.orientation.z = q.z(); odom.pose.pose.orientation.w = q.w();
+  PointCloudXYZI body;
+  body.reserve(backend_deskewed_lidar.size());
+  for (const auto &pt : backend_deskewed_lidar.points) {
+    PointType b = pt;
+    Eigen::Vector3d v = extR * Eigen::Vector3d(pt.x, pt.y, pt.z) + extT;
+    b.x=v.x(); b.y=v.y(); b.z=v.z();
+    body.push_back(b);
+  }
+  sensor_msgs::msg::PointCloud2 cloud;
+  pcl::toROSMsg(body, cloud);
+  cloud.header.stamp = odom.header.stamp; cloud.header.frame_id = odom.child_frame_id;
+  backend_last_odom = odom; backend_last_cloud = cloud;
+  backend_odom_pub->publish(odom); backend_cloud_pub->publish(cloud);
+}
