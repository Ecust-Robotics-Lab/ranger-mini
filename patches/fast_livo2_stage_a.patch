+void Preprocess::mid360_pc2_handler(const sensor_msgs::msg::PointCloud2::ConstSharedPtr &msg)
+{
+  pl_surf.clear();
+  if (msg->is_bigendian || msg->row_step < msg->width * uint64_t(msg->point_step) ||
+      msg->data.size() < uint64_t(msg->row_step) * msg->height || point_filter_num <= 0)
+    throw std::runtime_error("Invalid Mid360S PointCloud2 layout");
+  auto field = [&](const char *name, uint8_t type, size_t size) {
+    for(const auto &f : msg->fields) if(f.name == name) {
+      if(f.datatype != type || f.count != 1 || f.offset + size > msg->point_step)
+        throw std::runtime_error("Invalid Mid360S point field");
+      return f.offset;
+    }
+    throw std::runtime_error(std::string("Missing Mid360S field: ")+name);
+  };
+  auto ox=field("x",7,4), oy=field("y",7,4), oz=field("z",7,4);
+  auto oi=field("intensity",7,4), ot=field("timestamp",8,8), og=field("tag",2,1);
+  const int64_t base_ns = int64_t(msg->header.stamp.sec)*1000000000LL + msg->header.stamp.nanosec;
+  for(uint32_t row=0; row<msg->height; ++row) for(uint32_t col=0; col<msg->width; ++col) {
+    const auto *raw = msg->data.data()+size_t(row)*msg->row_step+size_t(col)*msg->point_step;
+    float x,y,z,intensity; double ts;
+    std::memcpy(&x,raw+ox,4); std::memcpy(&y,raw+oy,4); std::memcpy(&z,raw+oz,4);
+    std::memcpy(&intensity,raw+oi,4); std::memcpy(&ts,raw+ot,8);
+    double dt_ns=ts-double(base_ns);
+    const uint8_t tag=raw[og]&0x30;
+    if(!std::isfinite(x)||!std::isfinite(y)||!std::isfinite(z)||!std::isfinite(ts)||
+       !std::isfinite(intensity)||dt_ns < 0 || dt_ns > 150000000 ||
+       (tag!=0 && tag!=0x10) || (size_t(row)*msg->width+col)%point_filter_num ||
+       double(x)*x+double(y)*y+double(z)*z <= blind*blind) continue;
+    PointType pt{}; pt.x=x; pt.y=y; pt.z=z; pt.intensity=intensity;
+    pt.curvature=dt_ns*1e-6; // algorithm convention: milliseconds, never epoch ns
+    pl_surf.push_back(pt);
+  }
+  std::stable_sort(pl_surf.begin(),pl_surf.end(),[](const PointType&a,const PointType&b){return a.curvature<b.curvature;});
+}
