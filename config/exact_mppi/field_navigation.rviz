Panels:
- {Class: rviz_common/Displays, Name: Displays}
- {Class: rviz_common/Views, Name: Views}
Visualization Manager:
  Class: ''
  Global Options: {Background Color: '28; 30; 35', Fixed Frame: map, Frame Rate: 20}
  Displays:
  - Class: rviz_default_plugins/Map
    Name: Bound navigation map
    Enabled: true
    Topic: {Value: /map, Reliability Policy: Reliable, Durability Policy: Transient Local, Depth: 1}
    Alpha: 0.8
    Color Scheme: map
  - Class: rviz_default_plugins/PointCloud2
    Name: Live deskewed IMU cloud
    Enabled: true
    Topic: {Value: /fast_livo/deskewed_imu, Reliability Policy: Reliable, Depth: 2}
    Size (Pixels): 2
    Style: Points
    Color Transformer: AxisColor
    Axis: Z
    Position Transformer: XYZ
    Decay Time: 0.2
  - Class: rviz_default_plugins/Path
    Name: Planned path
    Enabled: true
    Topic: {Value: /plan, Reliability Policy: Reliable, Depth: 1}
    Color: '65; 130; 255'
    Line Style: Lines
    Line Width: 0.045
    Pose Style: None
  - Class: rviz_default_plugins/Path
    Name: Validated prediction
    Enabled: true
    Topic: {Value: /navigation/prediction, Reliability Policy: Reliable, Depth: 1}
    Color: '205; 100; 255'
    Line Style: Lines
    Line Width: 0.06
    Pose Style: None
  - Class: rviz_default_plugins/Path
    Name: Confirmed localization trail
    Enabled: true
    Topic: {Value: /fast_livo/localizer/view/path, Reliability Policy: Reliable, Depth: 1}
    Color: '60; 220; 130'
    Line Style: Lines
    Line Width: 0.035
    Pose Style: None
  - Class: rviz_default_plugins/Odometry
    Name: Mapped wheel odometry
    Enabled: true
    Topic: {Value: /fast_livo/navigation/wheel/odom, Reliability Policy: Reliable, Depth: 5}
    Keep: 1
    Shape: Arrow
  - Class: rviz_default_plugins/TF
    Name: Body and sensor frames
    Enabled: true
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Frame Timeout: 1
  # Deliberately provide viewing tools only. Goals use the recorded action client.
  Tools:
  - {Class: rviz_default_plugins/Interact}
  - {Class: rviz_default_plugins/MoveCamera}
  - {Class: rviz_default_plugins/Select}
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Office and corridor
      Target Frame: map
      Scale: 27
      X: 1.5
      Y: -9
      Angle: 0
  Value: true
Window Geometry: {Width: 1400, Height: 950, X: 40, Y: 40}
